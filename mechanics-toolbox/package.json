{
  "name": "mechanics-toolbox",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "面向机械结构工程师的离线力学快速计算工具箱",
  "scripts": {
    "typecheck": "vue-tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.node.json",
    "test": "vitest run --passWithNoTests",
    "test:e2e": "playwright test",
    "build": "npm run typecheck && vite build"
  },
  "dependencies": {
    "echarts": "^6.0.0",
    "katex": "^0.16.22",
    "vue": "^3.5.17"
  },
  "devDependencies": {
    "@playwright/test": "^1.54.1",
    "@types/node": "^24.0.15",
    "@vitejs/plugin-vue": "^6.0.0",
    "@vue/test-utils": "^2.4.6",
    "jsdom": "^26.1.0",
    "typescript": "^5.8.3",
    "vite": "^7.0.5",
    "vite-plugin-singlefile": "^2.3.0",
    "vitest": "^3.2.4",
    "vue-tsc": "^3.0.4"
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
